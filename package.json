{
  "name": "@z7onlabs/solana-inspector",
  "version": "0.4.0",
  "private": true,
  "description": "Offline Solana transaction evidence inspection: exact movements, fee attribution and unexplained balances.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.12 <23 || >=24 <25" },
  "packageManager": "pnpm@11.19.0",
  "bin": { "z7on-inspect": "./dist/src/inspector/node/cli.js" },
  "exports": {
    ".": { "types": "./dist/src/analytics/solana/inspection.d.ts", "import": "./dist/src/analytics/solana/inspection.js" },
    "./node": { "types": "./dist/src/inspector/node/index.d.ts", "import": "./dist/src/inspector/node/index.js" },
    "./internal/analytics/solana/account-ledger": { "types": "./dist/src/analytics/solana/account-ledger.d.ts", "import": "./dist/src/analytics/solana/account-ledger.js" },
    "./internal/analytics/solana/economic": { "types": "./dist/src/analytics/solana/economic.d.ts", "import": "./dist/src/analytics/solana/economic.js" },
    "./internal/analytics/solana/episode-checks": { "types": "./dist/src/analytics/solana/episode-checks.d.ts", "import": "./dist/src/analytics/solana/episode-checks.js" },
    "./internal/analytics/solana/fomo-fee-evidence": { "types": "./dist/src/analytics/solana/fomo-fee-evidence.d.ts", "import": "./dist/src/analytics/solana/fomo-fee-evidence.js" },
    "./internal/analytics/solana/inspection-requirements": { "types": "./dist/src/analytics/solana/inspection-requirements.d.ts", "import": "./dist/src/analytics/solana/inspection-requirements.js" },
    "./internal/analytics/solana/inspection-types": { "types": "./dist/src/analytics/solana/inspection-types.d.ts", "import": "./dist/src/analytics/solana/inspection-types.js" },
    "./internal/analytics/solana/inspection": { "types": "./dist/src/analytics/solana/inspection.d.ts", "import": "./dist/src/analytics/solana/inspection.js" },
    "./internal/analytics/solana/ledger": { "types": "./dist/src/analytics/solana/ledger.d.ts", "import": "./dist/src/analytics/solana/ledger.js" },
    "./internal/analytics/solana/normalize": { "types": "./dist/src/analytics/solana/normalize.d.ts", "import": "./dist/src/analytics/solana/normalize.js" },
    "./internal/analytics/solana/route-constants": { "types": "./dist/src/analytics/solana/route-constants.d.ts", "import": "./dist/src/analytics/solana/route-constants.js" },
    "./internal/analytics/solana/routes": { "types": "./dist/src/analytics/solana/routes.d.ts", "import": "./dist/src/analytics/solana/routes.js" },
    "./internal/analytics/solana/token-quantity-evidence": { "types": "./dist/src/analytics/solana/token-quantity-evidence.d.ts", "import": "./dist/src/analytics/solana/token-quantity-evidence.js" },
    "./internal/analytics/solana/types": { "types": "./dist/src/analytics/solana/types.d.ts", "import": "./dist/src/analytics/solana/types.js" },
    "./internal/analytics/spot/decimal": { "types": "./dist/src/analytics/spot/decimal.d.ts", "import": "./dist/src/analytics/spot/decimal.js" },
    "./internal/analytics/spot/engine": { "types": "./dist/src/analytics/spot/engine.d.ts", "import": "./dist/src/analytics/spot/engine.js" },
    "./internal/analytics/spot/index": { "types": "./dist/src/analytics/spot/index.d.ts", "import": "./dist/src/analytics/spot/index.js" },
    "./internal/analytics/spot/metrics": { "types": "./dist/src/analytics/spot/metrics.d.ts", "import": "./dist/src/analytics/spot/metrics.js" },
    "./internal/analytics/spot/prices": { "types": "./dist/src/analytics/spot/prices.d.ts", "import": "./dist/src/analytics/spot/prices.js" },
    "./internal/analytics/spot/types": { "types": "./dist/src/analytics/spot/types.d.ts", "import": "./dist/src/analytics/spot/types.js" },
    "./internal/analytics/spot/valuation": { "types": "./dist/src/analytics/spot/valuation.d.ts", "import": "./dist/src/analytics/spot/valuation.js" },
    "./internal/analytics/spot/version": { "types": "./dist/src/analytics/spot/version.d.ts", "import": "./dist/src/analytics/spot/version.js" },
    "./internal/analytics/value": { "types": "./dist/src/analytics/value.d.ts", "import": "./dist/src/analytics/value.js" },
    "./internal/lib/wallet-address": { "types": "./dist/src/lib/wallet-address.d.ts", "import": "./dist/src/lib/wallet-address.js" },
    "./internal/types/analytics": { "types": "./dist/src/types/analytics.d.ts", "import": "./dist/src/types/analytics.js" },
    "./internal/types/episode-checks": { "types": "./dist/src/types/episode-checks.d.ts", "import": "./dist/src/types/episode-checks.js" },
    "./internal/inspector/browser/reader": { "types": "./dist/src/inspector/browser/reader.d.ts", "import": "./dist/src/inspector/browser/reader.js" },
    "./internal/inspector/node/cli": { "types": "./dist/src/inspector/node/cli.d.ts", "import": "./dist/src/inspector/node/cli.js" },
    "./internal/inspector/node/html": { "types": "./dist/src/inspector/node/html.d.ts", "import": "./dist/src/inspector/node/html.js" },
    "./internal/inspector/node/index": { "types": "./dist/src/inspector/node/index.d.ts", "import": "./dist/src/inspector/node/index.js" },
    "./internal/inspector/node/input": { "types": "./dist/src/inspector/node/input.d.ts", "import": "./dist/src/inspector/node/input.js" },
    "./internal/inspector/node/output-budget": { "types": "./dist/src/inspector/node/output-budget.d.ts", "import": "./dist/src/inspector/node/output-budget.js" },
    "./internal/inspector/node/run": { "types": "./dist/src/inspector/node/run.d.ts", "import": "./dist/src/inspector/node/run.js" },
    "./internal/inspector/node/worker": { "types": "./dist/src/inspector/node/worker.d.ts", "import": "./dist/src/inspector/node/worker.js" }
  },
  "files": ["dist", "src", "README.md", "LICENSE", "NOTICE", "THIRD-PARTY-NOTICES.md", "docs/protocol-provenance.md", "BUILD-MANIFEST.json"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:examples": "node --test examples/examples.test.mjs",
    "examples:build": "node examples/generate-reports.mjs",
    "test:package": "node --test tests/package.test.mjs",
    "pack:check": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "decimal.js": "10.6.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
